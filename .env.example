APP_NAME="Schedule & Monitoring Sosmed"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Dipakai oleh `php artisan serve` (composer run dev).
# SERVER_HOST=127.0.0.1 artinya hanya komputer ini; 0.0.0.0 artinya
# bisa diakses dari jaringan. Ganti port di sini, bukan di composer.json.
SERVER_HOST=127.0.0.1
SERVER_PORT=5566
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autopost
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gemini (opsional) — aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Klasifikasi komentar ──────────────────────────────────────────────────────
# Driver: rule | groq | huggingface | openrouter | gemini
#   rule        = kamus offline, tanpa API, tanpa kuota (selalu jalan)
#   groq        = console.groq.com/keys        (paling mudah didapat)
#   huggingface = huggingface.co/settings/tokens  (token "Read")
#   openrouter  = openrouter.ai/keys
# Lapis kamus SELALU jalan lebih dulu; driver di bawah hanya menangani yang ambigu.
CRM_AI_DRIVER=rule

GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
CRM_SLA_URGENT_HOURS=2
CRM_SLA_NORMAL_HOURS=24

# Alamat PUBLIK untuk file media (gambar & video konten).
#
# Instagram tidak menerima file gambarnya -- ia menerima URL ini, lalu server
# Instagram yang mengunduh sendiri. Jadi alamat ini HARUS bisa dijangkau dari
# internet, sementara APP_URL boleh tetap alamat lokal.
#
# Kosongkan untuk deployment publik biasa: nilainya jatuh ke APP_URL.
# Isi kalau aplikasi ada di intranet dan hanya media yang dibuka lewat tunnel.
#
#   FILESYSTEM_PUBLIC_URL=https://media.domain-anda.ac.id/storage
FILESYSTEM_PUBLIC_URL=

# Proxy yang boleh dipercaya untuk header X-Forwarded-*.
# Default loopback, karena cloudflared/ngrok berjalan di komputer yang sama.
# TRUSTED_PROXIES=127.0.0.1,::1
